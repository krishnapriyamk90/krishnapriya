<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         OPPORTUNITIES LIST
    ====================================================== -->

    <template
            id="crm_opportunities"
            name="CRM Portal Opportunities">

        <t t-call="portal.portal_layout">

            <div class="crm-page">

                <div class="container py-4">

                    <div class="crm-page-header">

                        <div>

                            <h2 class="crm-page-title">
                                My Opportunities
                            </h2>

                            <p class="crm-page-subtitle">
                                Track and manage your sales opportunities.
                            </p>

                        </div>

                    </div>


                    <!-- Search -->

                    <div class="crm-filter-card">

                        <form
                                method="get"
                                action="/my/crm/opportunities">

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Search
                                    </label>

                                    <input
                                            type="text"
                                            name="search"
                                            t-att-value="search"
                                            class="form-control"
                                            placeholder="Search opportunity, email or phone..."/>

                                </div>


                                <div class="col-md-4">

                                    <label class="form-label">
                                        Stage
                                    </label>

                                    <select
                                            name="stage_id"
                                            class="form-select">

                                        <option
                                                value=""
                                                t-att-selected="not selected_stage and not lost_filter">
                                            All Active Opportunities
                                        </option>

                                        <t t-foreach="stages" t-as="stage">

                                            <option
                                                    t-att-value="stage.id"
                                                    t-att-selected="stage.id == selected_stage">

                                                <t t-esc="stage.name"/>

                                            </option>

                                        </t>

                                        <option
                                                value="lost"
                                                t-att-selected="lost_filter">

                                            Lost

                                        </option>

                                    </select>
                                </div>


                                <div class="col-md-2 d-flex align-items-end">

                                    <button
                                            type="submit"
                                            class="btn btn-dark w-100">

                                        Search

                                    </button>

                                </div>

                            </div>

                        </form>

                    </div>


                    <!-- Summary -->

                    <div class="crm-list-summary">

                        <strong>
                            <t t-esc="total"/>
                        </strong>

                        opportunities found

                    </div>


                    <!-- Table -->

                    <div class="crm-table-card">

                        <div class="table-responsive">

                            <table class="table crm-table">

                                <thead>

                                    <tr>

                                        <th>Opportunity</th>
                                        <th>Customer</th>
                                        <th>Stage</th>
                                        <th>Revenue</th>
                                        <th>Probability</th>
                                        <th>Closing</th>
                                        <th></th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <t t-if="opportunities">

                                        <t
                                                t-foreach="opportunities"
                                                t-as="opportunity">

                                            <tr>

                                                <td>

                                                    <a
                                                            t-att-href="'/my/crm/opportunities/%s' % opportunity.id"
                                                            class="crm-record-link">

                                                        <t t-esc="opportunity.name"/>

                                                    </a>

                                                </td>


                                                <td>

                                                    <t
                                                            t-esc="opportunity.partner_id.name or '-'"/>

                                                </td>


                                                <td>

                                                    <span class="crm-stage-badge">

                                                        <t
                                                                t-esc="opportunity.stage_id.name"/>

                                                    </span>

                                                </td>


                                                <td>

                                                    <t
                                                            t-esc="'{:,.2f}'.format(opportunity.expected_revenue or 0)"/>

                                                </td>


                                                <td>

                                                    <t
                                                            t-esc="'{}%'.format(int(opportunity.probability or 0))"/>

                                                </td>


                                                <td>

                                                    <t
                                                            t-esc="opportunity.date_deadline or '-'"/>

                                                </td>


                                                <td class="text-end">

                                                    <a
                                                            t-att-href="'/my/crm/opportunities/%s' % opportunity.id"
                                                            class="btn btn-sm btn-outline-primary">

                                                        View

                                                    </a>

                                                </td>

                                            </tr>

                                        </t>

                                    </t>


                                    <t t-else="">

                                        <tr>

                                            <td colspan="7">

                                                <div class="crm-empty-state">

                                                    <h5>
                                                        No opportunities found
                                                    </h5>

                                                    <p>
                                                        There are no opportunities matching your search.
                                                    </p>

                                                </div>

                                            </td>

                                        </tr>

                                    </t>

                                </tbody>

                            </table>

                        </div>

                    </div>


                    <!-- Pagination -->

                    <t t-if="page_count &gt; 1">

                        <div class="crm-pagination">

                            <t t-if="page &gt; 1">

                                <a
                                        t-att-href="'/my/crm/opportunities?page=%s&amp;search=%s&amp;stage_id=%s' % (page - 1, search or '', selected_stage or '')"
                                        class="btn btn-outline-secondary">

                                    ← Previous

                                </a>

                            </t>


                            <span class="crm-page-number">

                                Page

                                <strong>
                                    <t t-esc="page"/>
                                </strong>

                                of

                                <strong>
                                    <t t-esc="page_count"/>
                                </strong>

                            </span>


                            <t t-if="page &lt; page_count">

                                <a
                                        t-att-href="'/my/crm/opportunities?page=%s&amp;search=%s&amp;stage_id=%s' % (page + 1, search or '', selected_stage or '')"
                                        class="btn btn-outline-secondary">

                                    Next →

                                </a>

                            </t>

                        </div>

                    </t>

                </div>

            </div>

        </t>

    </template>


    <!-- =====================================================
         OPPORTUNITY DETAIL
    ====================================================== -->

    <template
            id="crm_opportunity_detail"
            name="CRM Portal Opportunity Detail">

        <t t-call="portal.portal_layout">

            <div class="crm-page">

                <div class="container py-4">

                    <div class="crm-detail-header">

                        <div>

                            <a
                                    href="/my/crm/opportunities"
                                    class="crm-back-link">

                                ← Back to Opportunities

                            </a>

                            <h2 class="crm-page-title mt-2">

                                <t t-esc="opportunity.name"/>

                            </h2>

                            <p class="crm-page-subtitle">

                                Opportunity details and pipeline information.

                            </p>

                        </div>

                        <div class="d-flex align-items-center gap-2">

                            <!-- Lost badge: status only, not a pipeline stage -->

                            <t t-if="not opportunity.active and opportunity.probability == 0">

                                <span class="badge bg-danger">
                                    Lost
                                </span>

                            </t>

                            <!-- Hide Edit for Lost opportunities -->

                            <t t-if="opportunity.active">

                                <a
                                        t-att-href="'/my/crm/opportunities/%s/edit' % opportunity.id"
                                        class="btn btn-primary">

                                    Edit Opportunity

                                </a>

                            </t>

                        </div>

                    </div>

                    <!-- Pipeline: show only for active opportunities -->

                    <t t-if="opportunity.active">

                    <div class="crm-detail-card">

                        <div
                                class="d-flex justify-content-between align-items-center mb-3">

                            <div>

                                <h4 class="crm-section-title mb-1">
                                    Pipeline
                                </h4>

                                <div class="text-muted small">
                                    Click any stage to move this opportunity.
                                </div>

                            </div>

                            <span class="crm-current-stage">

                                <t
                                        t-esc="opportunity.stage_id.name"/>

                            </span>

                        </div>


                        <div class="crm-pipeline-wrapper">

                            <div class="crm-pipeline">

                                <t
                                        t-foreach="stages"
                                        t-as="stage">

                                    <form
                                            t-att-action="'/my/crm/opportunities/%s/stage' % opportunity.id"
                                            method="post"
                                            class="crm-pipeline-form">

                                        <input
                                                type="hidden"
                                                name="csrf_token"
                                                t-att-value="request.csrf_token()"/>

                                        <input
                                                type="hidden"
                                                name="stage_id"
                                                t-att-value="stage.id"/>

                                        <button
                                                type="submit"
                                                t-att-class="'crm-pipeline-stage-button %s %s' % ('active' if stage.id == opportunity.stage_id.id else '', 'won' if stage.is_won else '')">

                                            <span class="crm-pipeline-stage-name">

                                                <t
                                                        t-esc="stage.name"/>

                                            </span>


                                        </button>

                                    </form>

                                </t>

                            </div>

                        </div>

                    </div>
                    </t>

                    <!-- =====================================================
                         MARK OPPORTUNITY AS LOST
                    ====================================================== -->

                    <t t-if="opportunity.active and not opportunity.stage_id.is_won and opportunity.probability != 0">

                        <div class="crm-detail-card mt-3">

                            <h4 class="crm-section-title">
                                Close Opportunity as Lost
                            </h4>

                            <p class="text-muted">
                                If this opportunity was unsuccessful, mark it as lost
                                and optionally record the reason.
                            </p>

                            <form
                                    t-att-action="'/my/crm/opportunities/%s/lost' % opportunity.id"
                                    method="post">

                                <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"/>

                                <div class="row g-3 align-items-end">

                                    <div class="col-md-8">

                                        <label class="form-label">
                                            Lost Reason
                                        </label>

                                        <select
                                                name="lost_reason_id"
                                                class="form-select">

                                            <option value="">
                                                Select a reason (optional)
                                            </option>

                                            <t t-foreach="lost_reasons" t-as="reason">

                                                <option t-att-value="reason.id">
                                                    <t t-esc="reason.name"/>
                                                </option>

                                            </t>

                                        </select>

                                    </div>

                                    <div class="col-md-4">

                                        <button
                                                type="submit"
                                                class="btn btn-outline-danger w-100"
                                                onclick="return confirm('Are you sure you want to mark this opportunity as lost?');">

                                            Mark as Lost

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>

                    </t>

                    <div class="row g-4 mt-1">

                        <!-- Information -->

                        <div class="col-lg-7">

                            <div class="crm-detail-card">

                                <h4 class="crm-section-title">
                                    Opportunity Information
                                </h4>


                                <div class="crm-info-grid">

                                    <div>

                                        <span class="crm-info-label">
                                            Customer
                                        </span>

                                        <strong>
                                            <t
                                                    t-esc="opportunity.partner_id.name or '-'"/>
                                        </strong>

                                    </div>


                                    <div>

                                        <span class="crm-info-label">
                                            Email
                                        </span>

                                        <strong>
                                            <t
                                                    t-esc="opportunity.email_from or '-'"/>
                                        </strong>

                                    </div>


                                    <div>

                                        <span class="crm-info-label">
                                            Phone
                                        </span>

                                        <strong>
                                            <t
                                                    t-esc="opportunity.phone or '-'"/>
                                        </strong>

                                    </div>


                                    <div>

                                        <span class="crm-info-label">
                                            Expected Closing
                                        </span>

                                        <strong>
                                            <t
                                                    t-esc="opportunity.date_deadline or '-'"/>
                                        </strong>

                                    </div>

                                </div>


                                <div class="mt-4">

                                    <span class="crm-info-label">
                                        Description
                                    </span>

                                    <div class="crm-description">

                                        <t t-if="opportunity.description">

                                            <t
                                                    t-esc="opportunity.description"/>

                                        </t>

                                        <t t-else="">

                                            No description available.

                                        </t>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Sales Information -->

                        <div class="col-lg-5">

                            <div class="crm-detail-card">

                                <h4 class="crm-section-title">
                                    Sales Information
                                </h4>


                                <div class="crm-metric">

                                    <span>
                                        Expected Revenue
                                    </span>

                                    <strong>

                                        <t
                                                t-esc="'{:,.2f}'.format(opportunity.expected_revenue or 0)"/>

                                    </strong>

                                </div>


                                <div class="crm-metric">

                                    <span>
                                        Probability
                                    </span>

                                    <strong>

                                        <t
                                                t-esc="'{}%'.format(int(opportunity.probability or 0))"/>

                                    </strong>

                                </div>


                                <div class="crm-metric">

                                    <span>
                                        Weighted Revenue
                                    </span>

                                    <strong>

                                        <t
                                                t-esc="'{:,.2f}'.format((opportunity.expected_revenue or 0) * (opportunity.probability or 0) / 100)"/>

                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Activities -->

                    <div class="crm-detail-card mt-4">

                        <h4 class="crm-section-title">
                            Activities
                        </h4>

                        <t t-if="activities">

                            <div class="crm-activity-list">

                                <t
                                        t-foreach="activities"
                                        t-as="activity">

                                    <div class="crm-activity-item">

                                        <div>

                                            <strong>

                                                <t
                                                        t-esc="activity.summary or activity.activity_type_id.name"/>

                                            </strong>

                                            <div class="crm-activity-meta">

                                                <t
                                                        t-esc="activity.date_deadline"/>

                                            </div>

                                        </div>

                                    </div>

                                </t>

                            </div>

                        </t>

                        <t t-else="">

                            <div class="crm-empty-state">

                                No activities for this opportunity.

                            </div>

                        </t>

                    </div>

                </div>

            </div>

        </t>

    </template>


    <!-- =====================================================
         EDIT OPPORTUNITY
    ====================================================== -->

    <template
            id="crm_opportunity_edit"
            name="CRM Portal Edit Opportunity">

        <t t-call="portal.portal_layout">

            <div class="crm-page">

                <div class="container py-4">

                    <div class="crm-detail-card">

                        <a
                                t-att-href="'/my/crm/opportunities/%s' % opportunity.id"
                                class="crm-back-link">

                            ← Back to Opportunity

                        </a>


                        <h2 class="crm-page-title mt-3">
                            Edit Opportunity
                        </h2>


                        <form
                                t-att-action="'/my/crm/opportunities/%s/edit' % opportunity.id"
                                method="post"
                                class="mt-4">

                            <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"/>


                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Opportunity Name
                                    </label>

                                    <input
                                            type="text"
                                            name="name"
                                            class="form-control"
                                            t-att-value="opportunity.name"/>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Email
                                    </label>

                                    <input
                                            type="email"
                                            name="email_from"
                                            class="form-control"
                                            t-att-value="opportunity.email_from or ''"/>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Phone
                                    </label>

                                    <input
                                            type="text"
                                            name="phone"
                                            class="form-control"
                                            t-att-value="opportunity.phone or ''"/>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Expected Revenue
                                    </label>

                                    <input
                                            type="number"
                                            name="expected_revenue"
                                            step="0.01"
                                            class="form-control"
                                            t-att-value="opportunity.expected_revenue or 0"/>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Probability
                                    </label>

                                    <input
                                            type="number"
                                            name="probability"
                                            min="0"
                                            max="100"
                                            step="0.01"
                                            class="form-control"
                                            t-att-value="opportunity.probability or 0"/>

                                </div>


                                <div class="col-md-6">

                                    <label class="form-label">
                                        Expected Closing
                                    </label>

                                    <input
                                            type="date"
                                            name="date_deadline"
                                            class="form-control"
                                            t-att-value="opportunity.date_deadline or ''"/>

                                </div>


                                <div class="col-12">

                                    <label class="form-label">
                                        Description
                                    </label>

                                    <textarea
                                            name="description"
                                            rows="5"
                                            class="form-control">
                                        <t t-esc="opportunity.description or ''"/>
                                    </textarea>

                                </div>

                            </div>


                            <div class="mt-4">

                                <button
                                        type="submit"
                                        class="btn btn-primary">

                                    Save Changes

                                </button>


                                <a
                                        t-att-href="'/my/crm/opportunities/%s' % opportunity.id"
                                        class="btn btn-outline-secondary ms-2">

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </t>

    </template>

</odoo>